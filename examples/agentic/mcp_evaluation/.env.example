# MCP Evaluation Benchmark — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Model configuration (optional — defaults shown) ──────────────────
# TEACHER_MODEL=openai/gpt-5.2
# JUDGE_MODEL=openai/gpt-4o

# ── Only needed for task generation (Section 2) ──────────────────────
# Skip these if using the pre-generated tasks in outputs/
LANGFLOW_URL_WEATHER_DATA=http://localhost:7860/api/v1/run/<flow-id>
LANGFLOW_URL_MEDICAL_CALCULATOR=http://localhost:7860/api/v1/run/<flow-id>
LANGFLOW_URL_WIKIPEDIA=http://localhost:7860/api/v1/run/<flow-id>
LANGFLOW_URL_CAR_PRICE=http://localhost:7860/api/v1/run/<flow-id>
LANGFLOW_URL_REDDIT=http://localhost:7860/api/v1/run/<flow-id>
LANGFLOW_URL_DEX_PAPRIKA=http://localhost:7860/api/v1/run/<flow-id>

# Langflow API key for authentication
LANGFLOW_API_KEY=
