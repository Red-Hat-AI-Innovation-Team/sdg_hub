# SDG Knowledge Tuning Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# MODEL CONFIGURATION
# Choose one of the following model providers: hosted_vllm, openai, ollama
# =============================================================================

MODEL_PROVIDER=hosted_vllm
LITELLM_MODE=PRODUCTION

# =============================================================================
# HOSTED VLLM CONFIGURATION
# =============================================================================
VLLM_MODEL=hosted_vllm/meta-llama/Llama-3.3-70B-Instruct
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
ENABLE_REASONING=false
MAX_CONCURRENCY=50
# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here  
OPENAI_MODEL=openai/gpt-5  

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================
OLLAMA_MODEL=ollama/gemma3
OLLAMA_API_BASE=http://localhost:11434

# =============================================================================
# MAAS CONFIGURATION (Red Hat AI Services)
# =============================================================================
MAAS_MODEL=your-provisioned-model-name
MAAS_API_BASE=your-provisioned-model-url
MAAS_API_KEY=your-maas-api-key-here

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
SEED_DATA_PATH=seed_data.jsonl
# Set this for subsampling the seed data. Useful for debugging or running validation
SEED_DATA_SUBSAMPLE=24
OUTPUT_DATA_FOLDER=output_data
RUN_ON_VALIDATION_SET=true
NUMBER_OF_SUMMARIES=50
GENERATE_CPT=false

# =============================================================================
# MULTILINGUAL CONFIGURATION
# Set to a language name to use translated flows (e.g., "Spanish")
# Leave empty or unset for English (default)
# Translated flows must exist in the flows registry. Use utils/translate_flow.py
# to create flows for new languages.
# =============================================================================
SDG_LANG=
# ISO 639-1 language code (e.g., "es" for Spanish, "fr" for French)
# Used for file suffixes and flow IDs by utils/translate_flow.py
SDG_LANG_CODE=
# Path to directory containing translated flows (created by utils/translate_flow.py)
# Only needed if using custom translated flows outside the installed package
TRANSLATED_FLOWS_DIR=

# =============================================================================
# TRANSLATION MODELS (used by utils/translate_flow.py)
# Separate model configs for prompt translation and verification, independent
# of the teacher model above. Uses litellm model format. Examples:
#   openai/gpt-4o, hosted_vllm/meta-llama/Llama-3.3-70B-Instruct, ollama/gemma3
# These can also be passed via CLI args: --translator and --verifier
# =============================================================================
TRANSLATION_API_KEY=
TRANSLATION_API_BASE=
# Optional: verifier model for translation quality checking
# Falls back to TRANSLATION_API_KEY if VERIFIER_API_KEY is not set
VERIFIER_API_KEY=
VERIFIER_API_BASE=

# =============================================================================
# DATA MIXING CONFIGURATION
# =============================================================================
SAVE_GPT_OSS_FORMAT=false
STUDENT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cut sizes for data mixing (comma-separated list of integers)
# Number of summaries to pick per document for each cut
CUT_SIZES=3,5,7

# Number of Q&A pairs per document
QA_PER_DOC=3

HF_TOKEN=your-hf-token